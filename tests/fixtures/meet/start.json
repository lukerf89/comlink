          "process_started_at": "<V>"
        }
      }
    ]
  },
  "session_dir": "<ROOT>/data/meetings/<SESSION>",
  "chunks_dir": "<ROOT>/data/meetings/<SESSION>/chunks",
  "segments_jsonl": "<ROOT>/data/meetings/<SESSION>/segments.jsonl",
